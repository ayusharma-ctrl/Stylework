NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://stylework:stylework@localhost:5438/stylework
DATABASE_DIRECT_URL=postgres://stylework:stylework@localhost:5438/stylework
REDIS_URL=redis://localhost:6388
ACCESS_TOKEN_SECRET=local-access-secret-change-before-deploy-123
REFRESH_TOKEN_SECRET=local-refresh-secret-change-before-deploy-123
# Webhook credentials are created in PostgreSQL with npm run webhook:key.
# WEBHOOK_KEY is optional client-only input for the sender/import CLI.
METRICS_TOKEN=local-metrics-secret-123
CLIENT_ORIGINS=http://localhost:5173,http://localhost:8080
TRUST_PROXY=
DB_POOL_MAX=10
WORKER_CONCURRENCY=10
MAX_PENDING_EVENTS=100000
MAX_INFLIGHT_REQUESTS=32
SIGNIN_IP_LIMIT=5
SIGNIN_EMAIL_LIMIT=5
READ_USER_LIMIT=300
READ_IP_LIMIT=1200
WRITE_USER_LIMIT=60
WRITE_IP_LIMIT=300
WEBHOOK_RATE=500
WEBHOOK_BURST=1000
WEBHOOK_IP_RATE=1000
SSE_USER_LIMIT=3
LOG_LEVEL=info
