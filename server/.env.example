NODE_ENV=development
PORT=3000
# Replace placeholders with your Neon connection strings for the SAME database/branch.
# Runtime: pooled endpoint. Migrations: direct endpoint (without -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@ep-your-endpoint-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@ep-your-endpoint.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full
# Use the provider's Redis TCP/TLS URL, not an HTTPS REST endpoint.
REDIS_URL=rediss://default:PASSWORD@YOUR_REDIS_HOST:6379
ACCESS_TOKEN_SECRET=local-access-secret-change-before-deploy-123
REFRESH_TOKEN_SECRET=local-refresh-secret-change-before-deploy-123
# Webhook credentials are created in PostgreSQL with npm run webhook:key.
# WEBHOOK_KEY is optional client-only input for the sender/import CLI.
METRICS_TOKEN=local-metrics-secret-123
CLIENT_ORIGINS=http://localhost:5173
TRUST_PROXY=
DB_POOL_MAX=4
WORKER_CONCURRENCY=1
RUN_WORKER=true
MAX_PENDING_EVENTS=5000
MAX_INFLIGHT_REQUESTS=16
# Requests per IP per minute. All REST routes share one bucket; webhook has its own.
API_RATE_LIMIT=120
WEBHOOK_RATE_LIMIT=60
LOG_LEVEL=info
