{
  "name": "stylework-server",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "dev:worker": "nodemon --watch src --ext ts --exec ts-node src/worker.ts",
    "test": "jest --runInBand",
    "test:integration": "jest --config test/jest.integration.json --runInBand",
    "db:migrate": "ts-node src/database/cli.ts migrate",
    "db:seed": "ts-node src/database/cli.ts seed",
    "smoke": "node scripts/smoke.mjs",
    "webhook:send": "node scripts/send-webhook.mjs",
    "webhook:replay": "ts-node src/scripts/replay.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/graphql": "^14.0.2",
    "@nestjs/apollo": "^14.0.2",
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "graphql": "^16.11.0",
    "graphql-query-complexity": "^1.1.0",
    "sequelize": "^6.37.8",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "umzug": "^3.8.2",
    "ioredis": "^5.8.2",
    "bullmq": "^5.58.0",
    "zod": "^4.1.11",
    "jsonwebtoken": "^9.0.2",
    "helmet": "^8.1.0",
    "pino": "^9.9.5",
    "prom-client": "^15.1.3",
    "dotenv": "^17.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.4",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.3",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.4",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.1.10"
  }
}
